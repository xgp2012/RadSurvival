# ------------------------------------------------------------------ 构建产物
target/
dist/
*.jar

# ------------------------------------------------------------------ 本地测试服务器（Paper 运行目录 + 世界存档 + 密钥）
# test-server/ 体积约 255 MB（服务器 jar 55 MB、世界存档、libraries），
# 且含 rcon-pass.txt 与 offline 模式凭据 —— 一律不入库。
test-server/

# ------------------------------------------------------------------ 跨服务端冒烟测试（v1.4）
# test-servers/ 下每个分支一个完整运行目录（jar + 世界存档 + 日志），
# 单分支约 250~300 MB，合计近 1 GB —— 与 test-server/ 同理一律不入库。
# 只保留脚本与模板：二者是可复现的验证资产，且体积极小。
test-servers/*/
!test-servers/run-smoke.ps1
!test-servers/server.properties.template

# ------------------------------------------------------------------ 密钥 / 凭据
**/rcon-pass.txt
*.pem
*.p12
*.jks

# ------------------------------------------------------------------ 本机环境残留（非工程内容）
# 注意：这里必须锚定到仓库根目录（前导 /），否则会误伤
# src/main/java/com/ft/radsurvival/config/ 源码包（曾导致 CI 编译失败）。
/acl-recovery/
/logs/
/config/

# ------------------------------------------------------------------ IDE / 操作系统
.idea/
.vscode/
*.iml
.settings/
.project
.classpath
Thumbs.db
desktop.ini
*.log
